# =============================================================================
# Turn2Law Document Generation Engine — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
.env

# Secrets and certificates — NEVER commit these
*.pfx
*.p12
*.key
*.pem

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
brand_preamble_rendered.tex

# Generated PDFs and TeX files (runtime outputs)
docgen/output*.pdf
docgen/output*.tex
docgen/output*.aux
docgen/output*.log
docgen/test_*.pdf
docgen/test_*.tex
docgen/templates/*.pdf
docgen/templates/*.tex
docgen/templates/*.aux
docgen/templates/*.log
# ...but the six SOURCE templates live in that directory and are the core
# assets of the engine. The rule above excluded them from the repo entirely,
# so the Docker image shipped without them and every generation failed with
# "No such file or directory: /app/templates/<type>_template.tex".
# Compiled output is named <12-hex-doc-id>.tex, which never matches this.
!docgen/templates/*_template.tex
!docgen/templates/brand_preamble.tex

# Generated documents directory (runtime output)
docgen/generated_docs/

# Branding profiles (runtime — contain processed PNGs and generated preambles)
docgen/branding/profiles/

# Preview images (runtime)
docgen/output_preview*.png
docgen/output_branded.*
docgen/output_nda.*
docgen/output_signed*.*
docgen/test_synkspace.*
docgen/sample.pdf

# VS Code
.vscode/

# pytest
.pytest_cache/

.kiro
.vscode

